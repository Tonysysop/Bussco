{
  "color": {
    "burgundy": "#9E1B22",
    "burgundyDeep": "#75141A",
    "canvas": "#F8F9FB",
    "surface": "#FFFFFF",
    "charcoal": "#1F2937",
    "textBody": "#4B5563",
    "textMuted": "#5B6472",
    "placeholder": "#8A929E",
    "border": "#E5E7EB",
    "borderInput": "#D1D5DB",
    "borderInputHover": "#9CA3AF",
    "divider": "#EEF0F3",
    "readonlyBg": "#F9FAFB",
    "readonlyText": "#6B7280",
    "toggleHoverBg": "#F3F4F6",
    "error": "#B42318",
    "errorInputBg": "#FFFBFA",
    "alertBg": "#FEF3F2",
    "alertBorder": "#FECDCA",
    "alertText": "#7A271A",
    "noticeBg": "#F6F4EF",
    "noticeBorder": "#E4DCCB",
    "noticeText": "#4A3F2A",
    "focusRing": "rgba(158,27,34,0.16)",
    "focusRingError": "rgba(180,35,24,0.16)"
  },
  "font": {
    "display": "'Newsreader', Georgia, serif",
    "body": "'Instrument Sans', system-ui, sans-serif",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Instrument+Sans:wght@400;500;600&display=swap"
  },
  "radius": { "card": 16, "control": 10, "toggle": 8 },
  "shadow": {
    "card": "0 1px 2px rgba(31,41,55,0.04), 0 24px 48px -24px rgba(31,41,55,0.18)"
  },
  "size": { "input": 48, "button": 52, "touchTarget": 44 },
  "watermark": { "opacity": 0.06, "tone": "mono" },
  "breakpoints": {
    "desktop": { "min": 1024, "frame": 1440 },
    "tablet": { "min": 600, "frame": 768 },
    "mobile": { "min": 360, "frame": 390 },
    "mobileSm": { "min": 0, "frame": 320 }
  },
  "layout": {
    "desktop":  { "headerPadding": "40px 80px 0", "mainPadding": "48px 80px 48px 168px", "align": "flex-start", "vAlign": "center", "columnWidth": 440, "h1": 72, "lead": 17, "cardPadding": 36, "stackGap": 28, "footerPadding": "0 80px 40px", "watermark": { "size": 1080, "left": 800, "top": -90 } },
    "tablet":   { "headerPadding": "36px 48px 0", "mainPadding": "48px", "align": "center", "vAlign": "center", "columnWidth": 472, "h1": 64, "lead": 17, "cardPadding": 36, "stackGap": 28, "footerPadding": "0 48px 36px", "watermark": { "size": 960, "left": 250, "top": 520 } },
    "mobile":   { "headerPadding": "24px 20px 0", "mainPadding": "36px 20px 32px", "align": "stretch", "vAlign": "flex-start", "columnWidth": 350, "h1": 48, "lead": 16, "cardPadding": 24, "stackGap": 24, "footerPadding": "0 20px 28px", "watermark": { "size": 620, "left": 120, "top": -200 } },
    "mobileSm": { "headerPadding": "20px 16px 0", "mainPadding": "28px 16px", "align": "stretch", "vAlign": "flex-start", "columnWidth": 288, "h1": 40, "lead": 15, "cardPadding": 20, "stackGap": 22, "footerPadding": "0 16px 24px", "watermark": { "size": 500, "left": 96, "top": -160 } }
  }
}
