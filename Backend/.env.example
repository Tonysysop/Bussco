# Copy to .env and load it into your shell (see README). Not read by Rails directly.

# Local PostgreSQL. Leave these unset to connect over the Unix socket as your
# OS user (needs: sudo -u postgres createuser -s "$USER").
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USERNAME=bussco
# DATABASE_PASSWORD=change-me

RAILS_MAX_THREADS=5

# Email (docs/auth/email-verification.md). Leave RESEND_API_KEY unset in development
# to write mail to tmp/mails/ instead of sending it.
# RESEND_API_KEY=re_...
# MAIL_FROM="BUSSCO <verify@your-domain>"
