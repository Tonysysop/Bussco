<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="format-detection" content="telephone=no, address=no, email=no, date=no, url=no" />
  <title><%= message.subject %></title>
  <style type="text/css">
    /* Reset styles for email clients */
    body, p, h1, h2, h3, div, span, td, a {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    body {
      width: 100% !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      background-color: #F7F8FA;
      margin: 0;
      padding: 0;
    }
    table {
      border-collapse: separate;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      border: 0;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
      display: block;
    }
    /* Mobile responsive rules */
    @media only screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
      }
      .email-card {
        border-radius: 12px !important;
        padding-left: 24px !important;
        padding-right: 24px !important;
        padding-top: 36px !important;
        padding-bottom: 36px !important;
      }
      .mobile-p-0 {
        padding: 12px !important;
      }
      .code-display {
        font-size: 32px !important;
        letter-spacing: 6px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F7F8FA; color: #1e293b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <!-- Preheader text (visible in inbox previews but hidden in email body) -->
  <div style="display: none; font-size: 1px; color: #F7F8FA; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
    <%= yield :preheader %>
  </div>

  <!-- Outer wrapper table -->
  <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#F7F8FA" style="background-color: #F7F8FA; table-layout: fixed; width: 100%;">
    <tr>
      <td align="center" style="padding: 48px 16px 56px 16px;">
        
        <!-- Main Email Container (Max Width 600px) -->
        <!--[if (gte mso 9)|(IE)]>
        <table role="presentation" width="580" align="center" border="0" cellpadding="0" cellspacing="0">
        <tr>
        <td>
        <![endif]-->
        <table role="presentation" class="email-container" width="100%" border="0" cellpadding="0" cellspacing="0" style="max-width: 580px; width: 100%; margin: 0 auto; text-align: left;">
          
          <!-- Header: Brand Emblem & Society Subtitle -->
          <tr>
            <td align="center" style="padding-bottom: 28px;">
              <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center">
                <tr>
                  <td align="center">
                    <!-- BUSSCO Brand Mark -->
                    <img src="<%= attachments["bussco.png"].url %>" alt="BUA Senior Staff Multipurpose Cooperative Society" width="170" style="width: 170px; max-width: 170px; height: auto; display: block; border: 0;" />
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top: 10px;">
                    <span style="font-size: 13px; font-weight: 500; color: #64748b; letter-spacing: 0.2px; text-transform: uppercase;">
                      BUA Staff Cooperative Society
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Main Content Card -->
          <tr>
            <td>
              <table role="presentation" class="email-card" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF" style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03); padding: 44px 40px; mso-padding-alt: 40px 36px;">
                <%= yield %>
              </table>
            </td>
          </tr>

          <!-- Footer Area -->
          <tr>
            <td style="padding-top: 28px; padding-bottom: 20px;">
              <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0">
                <!-- Thin Divider -->
                <tr>
                  <td style="border-top: 1px solid #E2E8F0; padding-bottom: 20px;"></td>
                </tr>
                <!-- Legal & Society Info -->
                <tr>
                  <td align="center" style="padding-bottom: 8px;">
                    <p style="font-size: 12.5px; font-weight: 500; color: #64748b; line-height: 1.5; margin: 0;">
                      © BUSSCO — BUA Staff Cooperative Society
                    </p>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <p style="font-size: 12px; color: #94a3b8; line-height: 1.5; margin: 0;">
                      This is an automated message. Please do not reply.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!--[if (gte mso 9)|(IE)]>
        </td>
        </tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>
