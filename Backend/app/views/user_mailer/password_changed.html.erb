<% content_for :preheader, "Your BUSSCO password was changed." %>
                
                <!-- Security / Badge Indicator -->
                <tr>
                  <td style="padding-bottom: 20px;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <td bgcolor="#FFF1F2" style="background-color: #FFF1F2; border: 1px solid #FFE4E6; border-radius: 20px; padding: 4px 12px;">
                          <span style="font-size: 11px; font-weight: 600; color: #9E1B22; text-transform: uppercase; letter-spacing: 0.5px;">
                            Security Notice
                          </span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Heading -->
                <tr>
                  <td style="padding-bottom: 24px;">
                    <h1 style="font-size: 24px; font-weight: 700; color: #0f172a; line-height: 1.3; margin: 0; letter-spacing: -0.3px;">
                      Your password was changed
                    </h1>
                  </td>
                </tr>

                <!-- Greeting & Body Text -->
                <tr>
                  <td style="padding-bottom: 14px;">
                    <p style="font-size: 15px; font-weight: 600; color: #1e293b; line-height: 1.6; margin: 0;">
                      Hello <%= @user.full_name %>,
                    </p>
                  </td>
                </tr>
                <tr>
                  <td style="padding-bottom: 32px;">
                    <p style="font-size: 15px; font-weight: 400; color: #475569; line-height: 1.65; margin: 0;">
                      The password for your BUSSCO account was just changed. You have been signed out everywhere; log in again with your new password.
                    </p>
                  </td>
                </tr>

                <!-- Secondary Advisory Message -->
                <tr>
                  <td style="padding-bottom: 4px;">
                    <p style="font-size: 13.5px; color: #64748b; line-height: 1.6; margin: 0;">
                      If you didn’t change your password, contact the cooperative secretariat right away.
                    </p>
                  </td>
                </tr>
